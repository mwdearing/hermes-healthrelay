#!/bin/sh
# Starts the read-only HealthRelay MCP server over stdio for your own receiver database.
# The database path is never stored in this package. Resolution order:
#   1. $HEALTHRELAY_DB  (only matters when you run this script by hand: Hermes does not pass it to MCP servers)
#   2. first line of ~/.config/healthrelay/db-path  (the route Hermes uses)
# The server is `health-bridge` on PATH.
set -eu

# --check mode: diagnose without starting the server
if [ "${1:-}" = "--check" ]; then
  echo "healthrelay check"
  # The db-path file is read from the HOME of the Hermes process (the MCP server's HOME). If this check
  # runs from another shell (or, in Docker, the agent terminal) the HOME can differ: compare this line.
  echo "home used for db-path: $HOME"
  if [ -r "$HOME/.config/healthrelay/db-path" ]; then
    echo "db-path file: $HOME/.config/healthrelay/db-path (found)"
  else
    echo "db-path file: $HOME/.config/healthrelay/db-path (missing)"
  fi

  db="${HEALTHRELAY_DB:-}"
  db_source="none"
  if [ -n "$db" ]; then
    db_source="environment (HEALTHRELAY_DB)"
  elif [ -r "$HOME/.config/healthrelay/db-path" ]; then
    db="$(head -n 1 "$HOME/.config/healthrelay/db-path")"
    db_source="db-path file (~/.config/healthrelay/db-path)"
  fi
  echo "database source: $db_source"

  if [ -n "$db" ]; then
    echo "database path: $db"
    if [ -f "$db" ] && [ -r "$db" ]; then
      echo "database readable: yes"
    elif [ -f "$db" ]; then
      echo "database readable: no (permission denied)"
    else
      echo "database readable: no (file not found)"
    fi
  else
    echo "database path: (not set)"
    echo "database readable: no (no path configured)"
  fi

  # Launcher detection
  launcher="none"
  if command -v health-bridge >/dev/null 2>&1; then
    launcher="$(command -v health-bridge)"
  fi
  echo "launcher: $launcher"

  # Version
  if [ "$launcher" != "none" ] && command -v health-bridge >/dev/null 2>&1; then
    ver="$(health-bridge --version 2>/dev/null || true)"
    echo "health-bridge version: ${ver:-unknown}"
  else
    echo "health-bridge version: unknown"
  fi

  # Final result
  if [ -n "$db" ] && [ -f "$db" ] && [ -r "$db" ] && [ "$launcher" != "none" ]; then
    echo "result: OK (could start)"
    exit 0
  else
    echo "result: NOT READY - write your receiver database path to ~/.config/healthrelay/db-path and make sure health-bridge is on PATH"
    exit 2
  fi
fi

db="${HEALTHRELAY_DB:-}"
if [ -z "$db" ] && [ -r "$HOME/.config/healthrelay/db-path" ]; then
  db="$(head -n 1 "$HOME/.config/healthrelay/db-path")"
fi
if [ -z "$db" ] || [ ! -f "$db" ]; then
  echo "healthrelay: write your receiver database path to ~/.config/healthrelay/db-path (then start a new session)" >&2
  exit 2
fi

if command -v health-bridge >/dev/null 2>&1; then
  exec health-bridge mcp start --db "$db"
fi
echo "healthrelay: install the receiver (health-bridge) so it is on the PATH Hermes runs with" >&2
exit 2
